{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/client-portal",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "/client-portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
